# Copy to apps/worker/.env. The worker is server-side only; nothing here reaches a browser.

# Supabase → Connect → Session pooler (port 5432). Bypasses RLS: the worker filters by org_id itself.
DATABASE_URL=
SUPABASE_URL=                     # same as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SECRET_KEY=              # storage access for uploads/exports

# AI (tasks that need a missing key fail with a clear message)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=                   # optional: without it, search is keyword-only
VOYAGE_MODEL=                     # optional, default voyage-3.5 (1024 dims)

# Microsoft Graph, app-only, Mail.Read on the shared mailbox (tenant admin consent)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MAIL_WEBHOOK_URL=                 # public https URL of the web app's /api/webhooks/mail
MAIL_INITIAL_SYNC_DAYS=7

# Slack incoming webhook for owner / inbox-duty alerts (without it, alerts are logged)
SLACK_WEBHOOK_URL=
APP_URL=http://localhost:3000     # links in alerts

WORKER_CONCURRENCY=2
