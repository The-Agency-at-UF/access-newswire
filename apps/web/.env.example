# Copy to apps/web/.env.local. Full list for all apps: AGENTS.md §6.

# Supabase — the hosted project (there is no local stack). Dashboard → Project
# Settings → API Keys for the publishable and secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                 # server only: Clerk webhook

# Clerk — dashboard → API keys. Webhook secret: dashboard → Webhooks → endpoint.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
